# Base URL the SPA uses for all API calls. Vite embeds this at build time.
#
# Local development:
#   VITE_API_BASE_URL=http://localhost:8000
#
# Production: point to your API host, e.g.
#   VITE_API_BASE_URL=https://api.example.com
# (leave unset to call the API same-origin, e.g. when served behind a proxy)
VITE_API_BASE_URL=http://localhost:8000